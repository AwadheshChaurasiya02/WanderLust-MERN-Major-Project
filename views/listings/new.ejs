<% layout("/layouts/boilerplate") -%>


    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h3>Create New Listing</h3>

    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="Add a title" id="title" class="form-control" required>
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please provides a valid title</div>
        </div>
        
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]"  class="form-control" id="description" required></textarea>
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please provides a better description</div>
        </div>

       <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select class="form-select" id="category" name="listing[category]" required>
            <option value="" selected disabled>Select Category</option>
            <option value="Trending">Trending</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Mountains">Mountains</option>
            <option value="Castles">Castles</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Arctic">Arctic</option>
            <option value="Domes">Domes</option>
            <option value="Boats">Boats</option>
        </select>
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please provides a valid category</div>
        </div>
        
        <div class="mb-3">
            <label for="image" class="form-label">Upload listing image</label>
            <input type="file" name="listing[image]" id="image" class="form-control" required>
        </div>


        <div class="row">

        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input type="number" name="listing[price]" placeholder="1200" class="form-control" id="price" required>
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please provides a valid price</div>
        </div>
        
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" placeholder="India" class="form-control" id="country" required>
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please provides a valid country</div>
        </div>

        </div>

        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" placeholder="Jaipur,Rajasthan" id="location" class="form-control" required>
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please provides a valid location</div>
        </div>
        
        <button class="btn btn-dark add-btn mb-3">Add</button>
    </form>
    </div>
    </div>

