<% layout("/layouts/boilerplate") -%>


<%
const countries = [...new Set(allListings.map(el => el.country))];
%>

<h3 class="heading">Explore destinations in <%= countries[0].charAt(0).toUpperCase() + countries[0].slice(1).toLowerCase() %></h3>
<div class="arrow">
    <i class="fa-solid fa-arrow-right"></i>
</div>



<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">
<% for(let listing of allListings){ %>
  <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card">
    <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">

    <div class="card-img-overlay"></div>

    <div class="card-body">
    <p class="card-text"><b><%=listing.title%></b><br>&#8377;<%=listing.price.toLocaleString("en-IN")%> / night <i class="tax-info">&nbsp; &nbsp;+18% GST</i> </p>
    </div>
    </div>
  </a>
  <% } %>

</div>